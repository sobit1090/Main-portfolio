<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no,maximum-scale=1.0" />
    <title>The Dev Chronicle - Editorial Desk</title>
    <script>
      document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/style.css" />
    <style>
      * {
        cursor: auto !important;
      }
      .admin-layout {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 40px;
        margin-top: 30px;
      }
      @media (max-width: 900px) {
        .admin-layout {
          grid-template-columns: 1fr;
          gap: 30px;
        }
      }
      .admin-header {
        text-align: center;
        border-bottom: 3px double var(--border-color);
        padding-bottom: 20px;
        margin-bottom: 30px;
      }
      .admin-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 2.8rem;
        text-transform: uppercase;
        font-weight: 900;
        letter-spacing: 2px;
      }
      .admin-tagline {
        font-family: 'Lora', Georgia, serif;
        font-style: italic;
        font-size: 1.1rem;
        margin-top: 5px;
      }
      .admin-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--border-color);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
      }
      .admin-nav a {
        color: var(--text-color);
        text-decoration: none;
        border-bottom: 1px dashed var(--border-color);
      }
      .admin-nav a:hover {
        color: var(--accent-color);
        border-color: var(--accent-color);
      }
      .card-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        margin-bottom: 20px;
        text-transform: uppercase;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
      }
      .form-field {
        margin-bottom: 20px;
      }
      .form-field label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-weight: bold;
        font-size: 0.85rem;
        text-transform: uppercase;
        margin-bottom: 6px;
      }
      .form-field input[type="text"],
      .form-field input[type="url"],
      .form-field textarea {
        width: 100%;
        padding: 12px;
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-color);
        font-family: 'Lora', Georgia, serif;
        font-size: 1rem;
      }
      .form-field input[type="text"]:focus,
      .form-field input[type="url"]:focus,
      .form-field textarea:focus {
        outline: none;
        border-color: var(--accent-color);
      }
      .checkbox-field {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 25px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        text-transform: uppercase;
      }
      .checkbox-field input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: var(--accent-color);
      }
      .btn-submit {
        background: var(--border-color);
        color: var(--bg-color);
        border: 1px solid var(--border-color);
        padding: 14px 30px;
        font-family: 'JetBrains Mono', monospace;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .btn-submit:hover {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 4px 4px 0 var(--border-color);
      }
      .admin-error {
        color: #d9534f;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        border: 1px dashed #d9534f;
        padding: 12px;
        margin-bottom: 20px;
        background: rgba(217, 83, 79, 0.05);
      }
      /* Project lists Table */
      .project-list-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .admin-project-card {
        display: flex;
        gap: 20px;
        padding: 15px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        transition: transform 0.2s ease;
      }
      .admin-project-card:hover {
        transform: translateY(-2px);
        background: var(--card-hover-bg);
      }
      .admin-project-thumb {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border: 1px solid var(--border-color);
      }
      .admin-project-details {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .admin-project-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 4px;
      }
      .admin-project-desc {
        font-size: 0.9rem;
        line-height: 1.4;
        opacity: 0.85;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .admin-project-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        margin-top: auto;
        opacity: 0.7;
      }
      .admin-project-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        justify-content: center;
      }
      .action-link {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        text-transform: uppercase;
        text-decoration: none;
        padding: 6px 12px;
        border: 1px solid var(--border-color);
        text-align: center;
        color: var(--text-color);
        transition: all 0.2s;
      }
      .action-link:hover {
        background: var(--border-color);
        color: var(--bg-color);
      }
      .action-delete {
        border-color: #d9534f;
        color: #d9534f;
        background: transparent;
        cursor: pointer;
      }
      .action-delete:hover {
        background: #d9534f;
        color: white;
        border-color: #d9534f;
      }
    </style>
  </head>
  <body>
    <!-- Scroll Progress Bar -->
    <div class="scroll-progress"></div>

    <div class="newspaper-container">
      <div class="admin-header">
        <div class="admin-title">Editorial Desk</div>
        <div class="admin-tagline">Dynamic Project Publisher Panel</div>
      </div>

      <div class="admin-nav">
        <span>Logged in as Editor-in-Chief</span>
        <div>
          <a href="/"><i class="fa-solid fa-house"></i> View Site</a>
          <span style="margin: 0 10px;">|</span>
          <a href="/admin/logout"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</a>
        </div>
      </div>

      <div class="admin-layout">
        <!-- Add/Edit Section -->
        <section style="margin: 30px 0; padding: 30px;">
          <div class="card-title">
            <%= editProject ? 'Edit Dispatch' : 'Publish New Dispatch' %>
          </div>

          <% if (error) { %>
            <div class="admin-error">⚠️ <%= error %></div>
          <% } %>

          <form method="POST" action="<%= editProject ? '/admin/projects/edit/' + editProject.id : '/admin/projects/add' %>">
            <div class="form-field">
              <label for="title">Project Title</label>
              <input type="text" id="title" name="title" value="<%= editProject ? editProject.title : '' %>" placeholder="e.g. Los Pollos Hermanos" required />
            </div>

            <div class="form-field">
              <label for="description">Dispatch Summary (Description)</label>
              <textarea id="description" name="description" rows="4" placeholder="Brief outline of the project capabilities..." required><%= editProject ? editProject.description : '' %></textarea>
            </div>

            <div class="form-field">
              <label for="image">Image Source (URL or Path)</label>
              <input type="text" id="image" name="image" value="<%= editProject ? editProject.image : '' %>" placeholder="e.g. /LosPollos/menu.png" required />
            </div>

            <div class="form-field">
              <label for="githubLink">GitHub Repository Link (URL)</label>
              <input type="url" id="githubLink" name="githubLink" value="<%= editProject ? editProject.githubLink : '' %>" placeholder="https://github.com/..." />
            </div>

            <div class="form-field">
              <label for="deployLink">Deploy / Destination Link (URL or Route)</label>
              <input type="text" id="deployLink" name="deployLink" value="<%= editProject ? editProject.deployLink : '' %>" placeholder="e.g. https://... or /projects/LosPollos" />
            </div>

            <div class="form-field">
              <label for="slug">URL Identifier (Slug)</label>
              <input type="text" id="slug" name="slug" value="<%= editProject ? editProject.slug : '' %>" placeholder="e.g. los-pollos (automatic if left empty)" />
            </div>

            <div class="checkbox-field">
              <input type="checkbox" id="isLocal" name="isLocal" <%= editProject && editProject.isLocal ? 'checked' : '' %> />
              <label for="isLocal">Render Local EJS Template (Custom page inside views/projects)</label>
            </div>

            <button type="submit" class="btn-submit">
              <%= editProject ? 'Update Dispatch' : 'Publish Project' %>
            </button>
            
            <% if (editProject) { %>
              <a href="/admin" class="action-link" style="display:inline-block; margin-left:10px; border-color:transparent;">Cancel</a>
            <% } %>
          </form>
        </section>

        <!-- List Section -->
        <section style="margin: 30px 0; padding: 30px;">
          <div class="card-title">Published Dispatches</div>
          
          <div class="project-list-container">
            <% if (projects.length === 0) { %>
              <p style="font-family: 'Lora', Georgia, serif; font-style: italic; opacity: 0.7;">No projects published yet.</p>
            <% } %>
            
            <% projects.forEach(project => { %>
              <div class="admin-project-card">
                <img src="<%= project.image %>" alt="<%= project.title %>" class="admin-project-thumb" />
                <div class="admin-project-details">
                  <div class="admin-project-title"><%= project.title %></div>
                  <div class="admin-project-desc"><%= project.description %></div>
                  <div class="admin-project-meta">
                    <span><%= project.isLocal ? 'Local Route' : 'External URL' %></span>
                    <% if (project.slug) { %>
                      <span style="margin: 0 5px;">|</span>
                      <span>Slug: <%= project.slug %></span>
                    <% } %>
                  </div>
                </div>
                <div class="admin-project-actions">
                  <a href="/admin/edit/<%= project.id %>" class="action-link"><i class="fa-solid fa-pen"></i> Edit</a>
                  <form method="POST" action="/admin/projects/delete/<%= project.id %>" onsubmit="return confirm('Are you sure you want to retract (delete) this project dispatch?');">
                    <button type="submit" class="action-link action-delete"><i class="fa-solid fa-trash-can"></i> Delete</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      </div>
    </div>
  </body>
</html>
